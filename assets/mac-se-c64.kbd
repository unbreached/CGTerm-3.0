# macOS + Swedish host keyboard -> C64-style mapping
#
# Character-based mapping: each PC key sends the PETSCII character
# that matches what's printed on the key, not positional C64 layout.
#
# Format: <c64_key_name> <SDL_keycode>
# Use keyboard test mode (ESC -> K -> T) to find SDL codes.

# Top row: numbers
arrowleft	96
one		49
two		50
three		51
four		52
five		53
six		54
seven		55
eight		56
nine		57
zero		48

# Swedish Mac: +/? key is SDL 93 (right bracket position)
# SDL 45 = minus key, SDL 61 = equals key
plus		93
minus		45
pound		127
home		278
del		8

# Letters (same on all layouts)
q		113
w		119
e		101
r		114
t		116
y		121
u		117
i		105
o		111
p		112
at		91
star		92
arrowup		39

stop		9
a		97
s		115
d		100
f		102
g		103
h		104
j		106
k		107
l		108

# Swedish Mac: Ö is at SDL 59 (US semicolon position)
#              Ä is at SDL 39 (US quote position)
# Map these to the C64 keys that produce ÅÖÄ screencodes
# when using the Swedish character ROM.
se_oe		59
se_ae		39
equal		61
return		13

# Bottom row
z		122
x		120
c		99
v		118
b		98
n		110
m		109
comma		44
dot		46
slash		47
down		274
right		275

space		32

f1		282
f3		284
f5		286
f7		288

f2		283
f4		285
f6		287
f8		289
