# CGTerm 3.0 - macOS Keyboard Layout
#
# Regular typing uses SDL unicode directly (no mapping needed).
# This file defines ALT (Commodore) and CTRL (C64 Ctrl) combos,
# plus special keys.
#
# Format: <c64_key_name> <SDL_keycode>
# Use keyboard test mode (ESC -> K -> T) to find SDL codes.

# Number row
arrowleft	96
one		49
two		50
three		51
four		52
five		53
six		54
seven		55
eight		56
nine		57
zero		48
plus		45
minus		61
pound		127
home		278
del		8

# Top letter row
q		113
w		119
e		101
r		114
t		116
y		121
u		117
i		105
o		111
p		112
at		91
star		93
arrowup		92

# Middle letter row
